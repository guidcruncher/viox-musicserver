{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
     "@/*": [
        "./src/*"
       ]
     }
  },
  "include": ["./src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts"]
}

{
  "name": "viox-musicserver",
  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run generate:barrels && npm run generate:routes && npm run format && tsx src/index.ts",
    "generate:routes": "tsx scripts/generate-routes.ts",
    "generate:barrels": "tsx scripts/generate-barrel.ts",
    "build": "npm run generate:routes && npm run build:api",
    "build:api": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "format": "prettier --config ./.prettierrc --write \"src/**/*.ts\" src/*.ts",
    "test": "vitest",
    "test:unit": "vitest --run --reporter=verbose",
    "test:watch": "vitest --watch",
    "lint": "eslint ./src/",
    "lint:fix": "eslint ./src/ --fix",
    "tidy": "knip --config ./knip.json",
    "tidy:write": "knip --fix --config ./knip.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/websocket": "^11.2.0",
    "@scalar/fastify-api-reference": "^1.48.4",
    "@sinclair/typebox": "^0.34.48",
    "axios": "^1.13.6",
    "better-sqlite3": "^12.6.2",
    "fastify": "^5.7.4",
    "ioredis": "^5.10.0",
    "mpd": "^1.3.0",
    "music-metadata": "^11.12.1",
    "node-cron": "^4.2.1",
    "prettier": "^3.8.1",
    "qrcode": "^1.5.4",
    "rss-parser": "^3.13.0",
    "string-similarity-js": "^2.1.4",
    "tslog": "^4.10.2",
    "undici": "^7.22.0",
    "youtubei.js": "^16.0.1",
    "ytdlp-nodejs": "^3.4.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.3",
    "@types/string-similarity": "^4.0.2",
    "@types/ws": "^8.18.1",
    "eslint": "^10.0.3",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "knip": "^5.85.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.57.0"
  }
}

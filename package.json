{
  "name": "viox-musicserver",
  "version": "0.1.0",
  "license": "MIT",
  "description": "VIOX Music Server",
  "keywords": "viox",
  "homepage": "https://github.com/guidcruncher/viox-musicserver",
  "author": "John Crocker <182365840+guidcruncher@users.noreply.github.com> (https://linktr.ee/johncrocker)",
  "funding": "https://buymeacoffee.com/guidcruncher",
  "main": "dist/index.js",
  "scripts": {
    "docker": "make dev",
    "dev": "pnpm run generate:barrels && pnpm run generate:routes && pnpm run format && tsx src/index.ts",
    "db": "sudo sqlite3 ../run/data/datastore.db",
    "generate:routes": "tsx scripts/generate-routes.ts",
    "generate:barrels": "tsx scripts/generate-barrel.ts",
    "build": "pnpm run generate:barrels && pnpm run generate:routes && pnpm run build:api",
    "build:api": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "format": "prettier --no-error-on-unmatched-pattern --config ./.prettierrc --write \"src/**/*.ts\" src/*.ts",
    "test": "vitest",
    "test:unit": "vitest --run --reporter=verbose",
    "test:watch": "vitest --watch",
    "lint": "eslint ./src/",
    "lint:fix": "eslint ./src/ --fix",
    "tidy": "pnpm run format && pnpm run lint:fix && knip --config ./knip.json",
    "tidy:write": "knip --fix --config ./knip.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/static": "^9.1.3",
    "@fastify/swagger": "^9.7.0",
    "@fastify/websocket": "^11.2.0",
    "@scalar/fastify-api-reference": "^1.52.3",
    "axios": "^1.15.1",
    "better-sqlite3": "^12.9.0",
    "cron": "^4.4.0",
    "fastify": "^5.8.5",
    "fft.js": "^4.0.4",
    "m3u8-parser": "^7.2.0",
    "music-metadata": "^11.12.3",
    "rss-parser": "^3.13.0",
    "tslog": "^4.10.2",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/m3u8-parser": "^7.2.6",
    "@types/node": "^25.6.0",
    "@types/string-similarity": "^4.0.2",
    "@types/ws": "^8.18.1",
    "eslint": "^10.2.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "knip": "^6.6.0",
    "prettier": "^3.8.3",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5"
  }
}
